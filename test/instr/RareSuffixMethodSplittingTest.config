{
  "redex" : {
    "passes" : [
      "RemoveNullcheckStringArgPass",
      "InstructionSequenceOutlinerPass",
      "RareSuffixMethodSplittingPass",
      "RegAllocPass"
    ]
  },
  "RareSuffixMethodSplittingPass": {
    "enabled": true,
    "min_compiled_call_sites": 1,
    "net_oat_weight": 1000
  },
  "baseline_profile": {
    "default": {
      "deep_data_interaction_config": {
        "ColdStart": {"name": "ColdStart"}
      }
    }
  },
  "InstructionSequenceOutlinerPass": {
    "outline_from_primary_dex": true,
    "full_dbg_positions": true
  }
}
