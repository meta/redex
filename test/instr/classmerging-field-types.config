{
  "redex" : {
    "passes" : [
      "ResolveRefsPass",
      "ClassMergingPass",
      "RegAllocPass",
      "LocalDcePass",
      "InterDexPass"
    ]
  },
  "ClassMergingPass" : {
    "preserve_unanimous_field_types" : true,
    "models" : [
      {
        "enabled" : true,
        "name" : "FieldTypes",
        "class_name_prefix" : "FieldTypes",
        "roots" : [
          "Lcom/facebook/redextest/TypedCaptureBase;",
          "Lcom/facebook/redextest/MixedCaptureBase;",
          "Lcom/facebook/redextest/ArrayCaptureBase;"
        ],
        "include_primary_dex" : true
      }
    ],
    "use_stable_shape_names" : true
  },
  "RegAllocPass" : {
    "live_range_splitting": false
  },
  "InterDexPass" : {
    "static_prune" : false,
    "normal_primary_dex" : true
  },
  "ir_type_checker": {
    "run_after_each_pass" : true,
    "verify_moves" : true
  }
}
