
{
  "redex" : {
    "passes" : [
      "ResolveRefsPass",
      "OptimizeResourcesPass",
      "DedupResourcesPass",
      "NullifyOptimizeResourcesPass",
      "RegAllocPass"
    ]
  },
  "pass_manager": {
    "pass_aliases": {
      "NullifyOptimizeResourcesPass": "OptimizeResourcesPass"
    }
  },
  "OptimizeResourcesPass": {
    "assume_reachable_prefixes": [
      "icon",
      "js_",
      "prickly",
      "x_"
    ],
    "delete_unused_files": true
  },
  "DedupResourcesPass": {
      "disallowed_resources": [
          "fbui_text_size_large"
      ],
      "disallowed_types": [
          "array",
          "attr",
          "styleable",
          "id",
          "plurals",
          "string"
      ]
  },
  "NullifyOptimizeResourcesPass": {
    "assume_id_inlined": true,
    "assume_reachable_prefixes": [
      "x_"
    ],
    "delete_unused_files": true
  },
  "compute_xml_reachability": true,
  "finalize_resource_table": true,
  "resources": {
    "customized_r_classes": [
      "Lcom/facebook/R;"
    ]
  }
}
